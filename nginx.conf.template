server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  location /api/ {
    proxy_pass http://${VITE_BACKEND_HOST}:${VITE_BACKEND_PORT};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
  }

  location = /env.js {
    add_header Cache-Control "no-store";
  }

  location / {
    try_files $uri /index.html;
  }
}
